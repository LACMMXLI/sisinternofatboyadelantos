{
  "name": "@libreta/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/write-dist-package-json.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(shared) sin linter propio; se valida vía typecheck\""
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
