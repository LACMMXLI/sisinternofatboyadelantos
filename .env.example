# Copia este archivo a .env (raíz) y ajusta los valores. .env nunca se
# versiona. Los valores de ejemplo son seguros solo para desarrollo local.

# ---- Núcleo ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# ---- Base de datos ----
POSTGRES_USER=libreta
POSTGRES_PASSWORD=libreta_dev_password
POSTGRES_DB=libreta_nominas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://libreta:libreta_dev_password@localhost:5432/libreta_nominas?schema=public

# ---- Autenticación (OBLIGATORIAS: genera valores propios, nunca reutilices estos) ----
JWT_ACCESS_SECRET=dev_only_access_secret_change_me
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---- Localización ----
DEFAULT_TIMEZONE=America/Tijuana
DEFAULT_CURRENCY=MXN

# ---- Almacenamiento S3 / MinIO (opcional en dev; si falta, se usa disco local) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=libreta-dev
S3_ACCESS_KEY=libreta_minio
S3_SECRET_KEY=libreta_minio_dev_secret
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=10
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Correo (opcional; sin SMTP se usa el flujo administrativo de contraseña temporal) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Observabilidad ----
LOG_LEVEL=info
